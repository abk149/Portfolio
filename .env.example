# Upstox app credentials — create an app at https://account.upstox.com/developer/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8765/callback

# Where to cache the access token (regenerated daily by Upstox)
UPSTOX_TOKEN_FILE=.cache/upstox_token.json

# ─── Agent brain ──────────────────────────────────────────────
# Pick one: "ollama" (local DeepSeek-R1 via Ollama) or "anthropic" (Claude API)
LLM_PROVIDER=ollama

# Claude — only used if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Ollama — only used if LLM_PROVIDER=ollama
# Install: brew install ollama && ollama serve
# Pull model: ollama pull deepseek-r1:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
# KB semantic search — `ollama pull nomic-embed-text` to enable it.
# Without it the KB still works, just with keyword (FTS5) search.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Retrieved KB chunks below this cosine similarity are discarded
# (keeps irrelevant context out of the LLM prompt).
KB_MIN_SIMILARITY=0.35

# Telegram — create a bot with @BotFather, get the token.
# To find your chat id, message the bot then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Comma-separated list — only these chat IDs are allowed to interact with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional shared secret for one-time /auth handshake (any string).
TELEGRAM_AUTH_SECRET=

# Optional
CACHE_DIR=.cache
LOG_LEVEL=INFO

# ─── D-R1-Quant extras ────────────────────────────────────────
# TimescaleDB DSN (leave blank to disable persistent logging).
# Example: postgresql://quant:quant@localhost:5432/quant
TIMESCALE_DSN=

# Local vector store (ChromaDB persists to this folder)
CHROMA_DIR=.cache/chroma

# Where to dump agent reasoning traces for future fine-tuning
TRACE_DIR=.cache/traces

# Risk-free rate (Indian 10Y G-Sec) used by MPT
RISK_FREE_RATE=0.07

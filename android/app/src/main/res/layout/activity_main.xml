<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- 1. Content Area -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomTabBar">

        <!-- Tab 1: WebView Dashboard -->
        <RelativeLayout
            android:id="@+id/tabDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <android.webkit.WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/webProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_alignParentTop="true"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/loadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0B0E14"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:indeterminateTint="#58A6FF" />

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="FastAPI Backend Booting..."
                    android:textColor="#E6EDF3"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Please ensure the servers are running in the Console tab"
                    android:textColor="#8B949E"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Tab 2: Console Terminal -->
        <LinearLayout
            android:id="@+id/tabConsole"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Logs Console"
                android:textColor="#E6EDF3"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <!-- Server Status Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#161B22"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Python FastAPI"
                        android:textColor="#8B949E"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvPythonStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STOPPED"
                        android:textColor="#FF7B72"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#161B22"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Llama Server (AI)"
                        android:textColor="#8B949E"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvLlamaStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STOPPED"
                        android:textColor="#FF7B72"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Command Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnStartServers"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Start Servers"
                    android:backgroundTint="#238636"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnStopServers"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Stop Servers"
                    android:backgroundTint="#DA3633"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Terminal Window -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#010409"
                android:padding="8dp">

                <ScrollView
                    android:id="@+id/consoleScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/consoleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="[System] Backend offline. Click Start Servers to launch uvicorn and llama-server.\n"
                        android:textColor="#58A6FF"
                        android:textSize="12sp" />
                </ScrollView>

                <ImageButton
                    android:id="@+id/btnClearConsole"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:background="#21262D"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#8B949E" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Tab 3: Settings & Models -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings &amp; local AI"
                    android:textColor="#E6EDF3"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="16dp" />

                <!-- 1. GGUF Model Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#161B22"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Select Active LLM Model"
                        android:textColor="#58A6FF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvActiveModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Model: (None selected - please download below)"
                        android:textColor="#E6EDF3"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSelectLocalModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose Custom GGUF File"
                        android:backgroundTint="#21262D"
                        android:textColor="#C9D1D9" />
                </LinearLayout>

                <!-- 2. Model Downloader -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#161B22"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Download DeepSeek R1 GGUF"
                        android:textColor="#58A6FF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DeepSeek-R1-Distill-Qwen-1.5B (1.1 GB Q4_K_M)\nRecommended for standard mobile processors. Low memory usage."
                        android:textColor="#8B949E"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnDownloadModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Download Distill-Qwen-1.5B (1.1GB)"
                        android:backgroundTint="#238636"
                        android:textColor="#FFFFFF" />

                    <!-- Download Progress State -->
                    <LinearLayout
                        android:id="@+id/downloadProgressLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/downloadProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:progress="0"
                            android:max="100" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tvDownloadProgressPct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#E6EDF3"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDownloadSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="0.0 MB/s"
                                android:textColor="#8B949E"
                                android:textSize="12sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Upstox Config Credentials -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#161B22"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Upstox API Credentials"
                        android:textColor="#58A6FF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#8B949E">
                        <EditText
                            android:id="@+id/etUpstoxApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Upstox API Key"
                            android:textColor="#E6EDF3"
                            android:textSize="14sp"
                            android:backgroundTint="#30363D" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColorHint="#8B949E">
                        <EditText
                            android:id="@+id/etUpstoxSecret"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Upstox Secret Key"
                            android:textColor="#E6EDF3"
                            android:textSize="14sp"
                            android:backgroundTint="#30363D"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColorHint="#8B949E">
                        <EditText
                            android:id="@+id/etRedirectUri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Redirect URI"
                            android:textColor="#E6EDF3"
                            android:textSize="14sp"
                            android:backgroundTint="#30363D" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnSaveConfig"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Credentials"
                        android:backgroundTint="#21262D"
                        android:textColor="#58A6FF" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 2. Bottom Tab Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#161B22"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:divider="?android:attr/dividerVertical"
        android:showDividers="middle">

        <TextView
            android:id="@+id/btnTabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Dashboard"
            android:textColor="#58A6FF"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnTabConsole"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Console"
            android:textColor="#8B949E"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Settings"
            android:textColor="#8B949E"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</RelativeLayout>

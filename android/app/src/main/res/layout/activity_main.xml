<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- 1. Native Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B0E14"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="PortfolioQuant"
            app:titleTextColor="#E6EDF3">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btnTopLogin"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    android:contentDescription="Broker Login"
                    app:tint="#3FB950" />

                <ImageButton
                    android:id="@+id/btnTopGlobalSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_manage"
                    android:contentDescription="AI Settings"
                    app:tint="#8B949E" />

                <ImageButton
                    android:id="@+id/btnTopConsole"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Console"
                    app:tint="#58A6FF" />

                <ImageButton
                    android:id="@+id/btnTopKB"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:contentDescription="Knowledge Base"
                    app:tint="#8B949E" />

                <ImageButton
                    android:id="@+id/btnTopAppSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:contentDescription="App Settings"
                    app:tint="#8B949E" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 2. Main Content Area -->
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- WebView for Dashboard Content -->
        <android.webkit.WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay for Native Pages (Settings, etc) -->
        <FrameLayout
            android:id="@+id/nativeOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0E14"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/nativeContentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </ScrollView>
        </FrameLayout>

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0B0E14"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            android:elevation="5dp">
            <ProgressBar android:layout_width="64dp" android:layout_height="64dp" android:indeterminateTint="#58A6FF" />
            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Python Server Offline\nStart via Console (top middle)"
                android:textAlignment="center"
                android:textColor="#8B949E" />
        </LinearLayout>

    </FrameLayout>

    <!-- 3. Native Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#161B22"
        app:itemIconTint="#8B949E"
        app:itemTextColor="#8B949E"
        app:menu="@menu/bottom_nav_menu" />

    <!-- 4. Global Console Overlay (Terminal) -->
    <LinearLayout
        android:id="@+id/consoleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B0E14"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="30dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Terminal"
                android:textColor="#E6EDF3"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnDownloadLogs"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/stat_sys_download"
                    app:tint="#3FB950"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#58A6FF"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btnCloseConsole"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#F85149" />
            </LinearLayout>
        </RelativeLayout>

        <ScrollView
            android:id="@+id/consoleScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#010409"
            android:padding="8dp">
            <TextView
                android:id="@+id/consoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#58A6FF"
                android:textSize="12sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnStartServers"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Start Servers"
                android:backgroundTint="#238636" />
            <Button
                android:id="@+id/btnStopServers"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Kill Process"
                android:layout_marginStart="8dp"
                android:backgroundTint="#DA3633" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

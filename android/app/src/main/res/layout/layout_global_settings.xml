<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Global AI Engine"
        android:textColor="#E6EDF3"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- 1. GGUF Model Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Local Model"
            android:textColor="#58A6FF"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/tvActiveModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="None selected"
            android:textColor="#E6EDF3"
            android:layout_marginBottom="12dp" />
        <Button
            android:id="@+id/btnSelectLocalModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Custom GGUF"
            android:backgroundTint="#21262D" />
        <Button
            android:id="@+id/btnDownloadModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download 1.5B (1.1GB)"
            android:layout_marginTop="8dp"
            android:backgroundTint="#238636" />

        <LinearLayout
            android:id="@+id/downloadProgressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">
            <ProgressBar android:id="@+id/downloadProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvDownloadProgressPct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6EDF3" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Cloud LLM & Ollama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cloud Providers" android:textColor="#58A6FF" android:layout_marginBottom="12dp" />
        <Spinner android:id="@+id/spnLlmProvider" android:layout_width="match_parent" android:layout_height="48dp" />
        <EditText android:id="@+id/etLlmApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API Key (NIM / Anthropic)" android:textColor="#E6EDF3" android:inputType="textPassword" />
        <EditText android:id="@+id/etOllamaHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ollama Host URL" android:textColor="#E6EDF3" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveGlobal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save AI Config"
        android:backgroundTint="#58A6FF"
        android:textColor="#FFFFFF" />

</LinearLayout>

# ── Python ──
.venv/
__pycache__/
*.pyc

# ── Secrets & runtime cache (NEVER commit) ──
.env            # matches .env in any directory, incl. the android python bundle
*.env
.cache/

# ── Android build artifacts / generated ──
android/build/
android/.gradle/
android/.kotlin/
android/app/build/
android/local.properties
android/captures/
*.apk
*.aab
# The phone Python bundle is regenerated from src/ + config/ at build time
# (Gradle syncPythonSource) — it is NOT source.
android/app/src/main/python/

# ── Stray nested repo (root-anchored; must NOT match com/portfolio/ package) ──
/Portfolio/

# ── Agent / tooling scratch ──
.claude/
*.command

# ── OS / editor ──
.DS_Store
**/.DS_Store

# JetBrains/Android Studio IDE files
android/.idea/
*.iml
